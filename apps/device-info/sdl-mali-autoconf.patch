+dnl Find the Mali framebuffer backend independently of KMSDRM.
+CheckMali()
+{
+    AC_ARG_ENABLE(video-mali,
+[AS_HELP_STRING([--enable-video-mali], [use Mali framebuffer video driver [default=no]])],
+                  , enable_video_mali=no)
+
+    if test x$enable_video = xyes && test x$enable_video_mali = xyes && \
+       test x$video_opengl_egl = xyes; then
+        AC_DEFINE(SDL_VIDEO_DRIVER_MALI, 1, [ ])
+        SOURCES="$SOURCES $srcdir/src/video/mali-fbdev/*.c"
+        EXTRA_CFLAGS="$EXTRA_CFLAGS -DLINUX -DEGL_API_FB"
+        have_video=yes
+        SUMMARY_video="${SUMMARY_video} mali"
+    fi
+}

+/* A frontend that runs ahead saves a state and loads it back on every frame. A state used to
+ * be built in memory mapped for that one save and unmapped after it, growing as it was
+ * written, which cost more than the save itself. One buffer is kept for the session instead.
+ * It is cleared before each save, so a state is byte for byte what a fresh buffer gave. */
 static struct VFile* _saveState(void) {
 #ifdef M_CORE_GBA
 	if (linkMode) {
 		return _linkSaveState();
 	}
 #endif
-	struct VFile* vfm = VFileMemChunk(NULL, 0);
-	mCoreSaveStateNamed(core, vfm, SAVESTATE_SAVEDATA | SAVESTATE_RTC);
-	return vfm;
+	if (!stateScratch) {
+		stateScratch = VFileMemChunk(NULL, 0);
+	} else {
+		size_t used = stateScratch->size(stateScratch);
+		void* old = stateScratch->map(stateScratch, used, MAP_WRITE);
+		if (old) {
+			memset(old, 0, used);
+			stateScratch->unmap(stateScratch, old, used);
+		}
+		stateScratch->truncate(stateScratch, 0);
+		stateScratch->seek(stateScratch, 0, SEEK_SET);
+	}
+	mCoreSaveStateNamed(core, stateScratch, SAVESTATE_SAVEDATA | SAVESTATE_RTC);
+	return stateScratch;
+}
+
+static void _doneState(struct VFile* vfm) {
+	if (vfm != stateScratch) {
+		vfm->close(vfm);
+	}
 }
 

 	if ((ssize_t) size > vfm->size(vfm)) {
 		size = vfm->size(vfm);
 	} else if ((ssize_t) size < vfm->size(vfm)) {
-		vfm->close(vfm);
+		_doneState(vfm);
 		return false;
 	}
 	vfm->seek(vfm, 0, SEEK_SET);
 	vfm->read(vfm, data, size);
-	vfm->close(vfm);
+	_doneState(vfm);
+	return true;
+}
+
+/* mCoreLoadStateNamed without its copy of the state into freshly mapped memory: the core
+ * reads the frontend's buffer where it lies. The cartridge's save memory is put back only
+ * when the state's differs from what is there now. Putting it back replaces the save memory
+ * with a copy that is written through to the real one some frames after the game last wrote
+ * to it, so doing that on every frame would keep a game's saves from the frontend for longer
+ * than it needs to, as well as mapping and unmapping the copy each time. */
+static bool _loadStateInPlace(const void* data, size_t size) {
+	if (size < core->stateSize(core) || ((uintptr_t) data & 15)) {
+		return false;
+	}
+	if (!core->loadState(core, data)) {
+		return false;
+	}
+	struct mStateExtdata extdata;
+	mStateExtdataInit(&extdata);
+	struct VFile* vfm = VFileFromConstMemory(data, size);
+	if (vfm) {
+		mCoreExtractExtdata(core, vfm, &extdata);
+		vfm->close(vfm);
+	}
+	core->loadExtraState(core, &extdata);
+
+	struct mStateExtdataItem item;
+	if (mStateExtdataGet(&extdata, EXTDATA_SAVEDATA, &item) && item.data) {
+		void* now = NULL;
+		size_t nowSize = core->savedataClone(core, &now);
+		bool same = now && nowSize == (size_t) item.size && !memcmp(now, item.data, nowSize);
+		free(now);
+		if (!same) {
+			core->savedataRestore(core, item.data, item.size, false);
+		}
+	}
+	if (mStateExtdataGet(&extdata, EXTDATA_RTC, &item) && core->rtc.d.deserialize) {
+		core->rtc.d.deserialize(&core->rtc.d, &item);
+	}
+	mStateExtdataDeinit(&extdata);
 	return true;
 }
 
